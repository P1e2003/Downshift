{
  "downshift": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"./scripts/run_hook.cmd\" ./scripts/pre_invocation.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "\"./scripts/run_hook.cmd\" ./scripts/pre_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
